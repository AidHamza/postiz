# Postiz runtime configuration lives OUTSIDE git, on the server:
#   /opt/appsdoc/postiz/shared/infra.env  (0600)  Compose interpolation
#   /opt/appsdoc/postiz/shared/app.env    (0600)  postiz container environment
# scripts/configure.sh generates the secrets below once and never rotates them.
# Placeholders only. Never commit real values.

# ---- infra.env ----
POSTIZ_PUBLIC_URL=https://social.appsdoc.com
POSTIZ_DB_PASSWORD=<generated: openssl rand -hex 32>
POSTIZ_REDIS_PASSWORD=<generated>
TEMPORAL_DB_PASSWORD=<generated>

# ---- app.env (generated) ----
JWT_SECRET=<generated>
ENCRYPTION_PROVIDER=local
ENCRYPTION_KEY=<generated: openssl rand -base64 32 — NEVER change after first use>
API_LIMIT=300

# ---- app.env (email; imported from the OpenPanel SMTP relay by deploy) ----
# EMAIL_PROVIDER=nodemailer
# EMAIL_HOST= EMAIL_PORT= EMAIL_SECURE= EMAIL_USER= EMAIL_PASS=
# EMAIL_FROM_ADDRESS= EMAIL_FROM_NAME=AppsDoc Social

# ---- app.env (social providers; add when approved, see docs/PROVIDERS.md) ----
# FACEBOOK_APP_ID= FACEBOOK_APP_SECRET=          # Facebook + Instagram (business)
# INSTAGRAM_APP_ID= INSTAGRAM_APP_SECRET=        # Instagram standalone
# THREADS_APP_ID= THREADS_APP_SECRET=
# LINKEDIN_CLIENT_ID= LINKEDIN_CLIENT_SECRET=
# TIKTOK_CLIENT_ID= TIKTOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID= YOUTUBE_CLIENT_SECRET=      # also Google login + GMB fallback
# PINTEREST_CLIENT_ID= PINTEREST_CLIENT_SECRET=
# X_API_KEY= X_API_SECRET=
# SLACK_ID= SLACK_SECRET= SLACK_SIGNING_SECRET=

# ---- optional paid services: disabled; leave unset ----
# OPENAI_API_KEY=
# NEXT_PUBLIC_POLOTNO=
