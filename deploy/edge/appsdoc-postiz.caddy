# AppsDoc Postiz (social.appsdoc.com) for the shared server-edge Caddy.
# Installed by scripts/install-edge.sh from the AppsDoc/postiz release:
#   /opt/server-edge/sites/appsdoc-postiz.caddy
# Upstream: alias `appsdoc-postiz` on `public-edge` (compose.yaml), port 5000 =
# the image's internal nginx (/ -> frontend, /api -> backend, /uploads -> files).
# DNS: proxied (orange-cloud) A record. TLS: Let's Encrypt HTTP-01 through
# Cloudflare; zone SSL mode is Full (strict).

social.appsdoc.com {
	import site_defaults social.appsdoc.com

	# Only Cloudflare may set CF-Connecting-IP; direct origin hits get the peer.
	@appsdoc_postiz_not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @appsdoc_postiz_not_cloudflare CF-Connecting-IP {remote_host}

	# Cloudflare Free caps proxied request bodies at 100 MB.
	request_body {
		max_size 100MB
	}

	# Private API responses must never be cached at the edge.
	@appsdoc_postiz_api path /api/*
	header @appsdoc_postiz_api >Cache-Control "private, no-store"

	# Google Workspace (Cloudflare Access OIDC) is the only login. Postiz v2.26.0
	# has no setting to turn off email/password, so its endpoints stop here.
	# OIDC uses /api/auth/oauth/GENERIC* and /api/auth/register (GENERIC token);
	# LOCAL registration is refused by the app (DISABLE_REGISTRATION=true).
	@appsdoc_postiz_password path /api/auth/login /api/auth/forgot /api/auth/forgot-return /api/auth/activate /api/auth/resend-activation
	respond @appsdoc_postiz_password "Password login is disabled. Use AppsDoc Google Workspace." 403
	@appsdoc_postiz_password_pages path /auth/forgot /auth/forgot/* /auth/activate /auth/activate/*
	redir @appsdoc_postiz_password_pages /auth/login 302

	reverse_proxy appsdoc-postiz:5000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
